{
  "name": "dsh-plugin-doubao",
  "version": "0.2.0",
  "description": "Doubao models in DSH, self-contained: talks to doubao.com over plain HTTP and registers itself as an LLM provider. No proxy to start — sign in once with a QR code.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "bin": {
    "dsh-plugin-doubao": "bin/login.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "doubao",
    "model-provider"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
